# =============================================
# BANCO DE DADOS
# =============================================
DATABASE_URL=postgresql://usebarber:SENHA_AQUI@localhost:5432/usebarber

# =============================================
# PARA DOCKER COMPOSE
# =============================================
POSTGRES_PASSWORD=SENHA_DO_BANCO_AQUI

# =============================================
# AUTENTICAÇÃO (NextAuth v5)
# Gere com: openssl rand -base64 32
# =============================================
AUTH_SECRET=gere_uma_chave_secreta_aqui
AUTH_URL=https://seudominio.com
AUTH_TRUST_HOST=true

# =============================================
# GOOGLE OAUTH
# console.cloud.google.com → Credenciais → Criar OAuth Client ID
# Authorized redirect URIs: https://seudominio.com/api/auth/callback/google
# =============================================
GOOGLE_CLIENT_ID=seu_google_client_id
GOOGLE_CLIENT_SECRET=seu_google_client_secret

# =============================================
# PAGAMENTOS — PAGAR.ME (STONE)
# Gateway principal: PIX (agendamentos + assinaturas) e assinatura recorrente por cartão.
# Painel: https://dashboard.pagar.me → Chaves de API
# =============================================
PAGARME_SECRET_KEY=sua_secret_key_pagarme
NEXT_PUBLIC_PAGARME_PUBLIC_KEY=sua_public_key_pagarme
PAGARME_WEBHOOK_SECRET=
PAGARME_PLATFORM_FEE_PERCENT=0
PAGARME_PLATFORM_RECIPIENT_ID=

# =============================================
# PAGAMENTOS — ASAAS
# Mantido só pra saques (transferências PIX) e pra processar assinantes antigos
# que ainda estejam com cobrança recorrente ativa no Asaas.
# Produção: https://api.asaas.com/v3
# Sandbox:  https://sandbox.asaas.com/api/v3
# =============================================
ASAAS_URL=https://api.asaas.com/v3
ASAAS_API_KEY=sua_chave_asaas_producao
# Token de autenticação configurado no painel do Asaas (Integrações → Webhooks)
# — sem ele, o webhook fica permissivo (não valida a origem da requisição).
ASAAS_WEBHOOK_TOKEN=

# =============================================
# IA
# =============================================
GEMINI_API_KEY=sua_chave_gemini

# =============================================
# PUSH NOTIFICATIONS (Web Push / VAPID)
# Gere com: npx web-push generate-vapid-keys
# =============================================
VAPID_PUBLIC_KEY=sua_vapid_public_key
VAPID_PRIVATE_KEY=sua_vapid_private_key
